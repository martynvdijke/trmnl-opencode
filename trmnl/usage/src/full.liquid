<div class="layout layout--col layout--stretch gap">
  {% if error %}
    <div class="item">
      <div class="content">
        <span class="value value--medium">{{ error }}</span>
      </div>
    </div>
  {% else %}
    <div class="item">
      <div class="content">
        <span class="value value--medium">{{ totals[0].sessions }} sessions today</span>
      </div>
      <div class="meta">
        <span class="label">{{ totals[0].cost_display }} · {{ totals[0].tokens_display }} tokens · {{ timezone }}</span>
      </div>
    </div>

    <div class="hr"></div>

    <div class="item">
      <span class="value value--small">Last 7 days</span>
      {% for day in daily %}
        <div class="meta">
          <span class="label">{{ day.label }} — {{ day.sessions }} sessions · {{ day.cost_display }}</span>
        </div>
      {% endfor %}
    </div>

    <div class="hr"></div>

    <div class="item">
      <span class="value value--small">Last 30 days</span>
      {% for day in monthly %}
        <div class="meta">
          <span class="label">{{ day.label }} — {{ day.sessions }} sessions · {{ day.cost_display }}</span>
        </div>
      {% endfor %}
    </div>

    {% if models.size > 0 %}
      <div class="hr"></div>
      <div class="item">
        <span class="value value--small">Models by spend</span>
        {% for model in models %}
          <div class="meta">
            <span class="label">{{ model.name }} — {{ model.sessions }} sessions · {{ model.cost_display }}</span>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  {% endif %}
  <div class="title_bar">
    <span class="title">OpenCode Usage · {{ generated_at }}</span>
  </div>
</div>
